{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "theme": "opencode",
  "autoshare": false,

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run *": "allow",
      "rm -rf *": "deny",
      "git push*": "deny"
    },
    "skill": {
      "*": "allow",
      "interne-*": "ask"
    },
    "webfetch": "allow",
    "external_directory": "deny"
  },

  "agent": {
    "plan": {
      "model": "anthropic/claude-haiku-4-5",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "npm run test*": "allow"
        }
      }
    }
  },

  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": false
    }
  },

  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    }
  },

  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".json", ".md"]
    }
  }
}
